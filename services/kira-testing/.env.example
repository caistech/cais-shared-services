# Kira Testing service — environment
# The resolved OmniRoute combo for the logical kira-testing service (e.g. "kira-testing")
KIRA_TESTING_MODEL_COMBO=
# OmniRoute gateway this service talks to (self-hosted, OpenAI-compatible)
KIRA_TESTING_OMNIROUTE_BASE_URL=http://localhost:20128
# Dedicated OmniRoute key for the Kira-testing service (preferred)
KIRA_TESTING_OMNIROUTE_API_KEY=
# Fallback credential + base (shared OmniRoute gateway)
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
